
# ==========================================
# Electronic-EDC Platform - Environment Config
# ==========================================

# Application
APP_NAME=Electronic EDC Platform API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Server
HOST=127.0.0.1
PORT=8000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=root
DB_PASSWORD=your_database_password

# SQLAlchemy Database URL
DATABASE_URL=mysql+pymysql://root:your_database_password@localhost:3306/your_database_name

# JWT Authentication
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Student Account Activation
LICENSE_KEY_LENGTH=16
LICENSE_KEY_EXPIRE_DAYS=365
